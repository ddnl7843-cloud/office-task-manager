# Copy this file to .env and fill in your real values.
# Do not commit the actual .env file to GitHub.

PORT=3000
APP_URL=https://task.paisafin.com

# Hostinger Webmail / SMTP settings
# SMTP_USER must be the full email address, for example: notifications@paisafin.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@paisafin.com
SMTP_PASS=
SMTP_FROM_NAME=PaisaFin Task Management
SMTP_FROM_EMAIL=notifications@paisafin.com
